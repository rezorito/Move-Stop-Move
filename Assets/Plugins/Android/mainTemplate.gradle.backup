apply plugin: 'com.android.application'

configurations.all {
    resolutionStrategy {
        // Force specific versions for all conflicting dependencies
        force 'com.squareup.picasso:picasso:2.8',
              'org.jetbrains:annotations:23.0.0',
              'androidx.arch.core:core-runtime:2.2.0',
              'com.squareup.okhttp3:okhttp:4.12.0',
              'androidx.lifecycle:lifecycle-process:2.6.2',
              'org.jetbrains.kotlinx:kotlinx-serialization-json:1.5.1',
              'androidx.browser:browser:1.6.0',
              'com.google.android.gms:play-services-basement:18.2.0',
              'com.google.android.gms:play-services-tasks:18.0.2',
              'androidx.startup:startup-runtime:1.1.1',
              'io.appmetrica.analytics:analytics:5.2.0',
              
              // Kotlin versions - sử dụng version từ đoạn thứ hai (1.9.22)
              'org.jetbrains.kotlin:kotlin-stdlib:1.9.22',
              'org.jetbrains.kotlin:kotlin-stdlib-common:1.9.22',
              'org.jetbrains.kotlin:kotlin-stdlib-jdk7:1.9.22',
              'org.jetbrains.kotlin:kotlin-stdlib-jdk8:1.9.22',
              
              // Thêm các dependency từ đoạn thứ hai
              'androidx.activity:activity:1.6.1',
              'androidx.annotation:annotation-experimental:1.3.0',
              'androidx.appcompat:appcompat:1.3.1',
              'androidx.core:core:1.6.0',
              'androidx.fragment:fragment:1.3.6',
              'androidx.lifecycle:lifecycle-runtime:2.3.1',
              'androidx.webkit:webkit:1.6.0',
              'org.jetbrains.kotlinx:kotlinx-coroutines-core:1.7.3',
              'org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3',
              'com.squareup.okio:okio:3.6.0'
        
        preferProjectModules()
        failOnVersionConflict()
        
        // Thêm resolution strategy cho từng dependency
        eachDependency { details ->
            if (details.requested.group == 'androidx.webkit' && details.requested.name == 'webkit') {
                details.useVersion '1.6.0'
                details.because 'Compatible with AGP 7.4.2'
            }
            // Force Kotlin versions
            if (details.requested.group == 'org.jetbrains.kotlin') {
                details.useVersion '1.9.22'
                details.because 'Force Kotlin version to avoid conflicts'
            }
            if (details.requested.group == 'org.jetbrains.kotlinx') {
                if (details.requested.name.contains('coroutines')) {
                    details.useVersion '1.7.3'
                    details.because 'Force coroutines version to avoid conflicts'
                }
            }
        }
    }
}

dependencies {
    implementation project(':unityLibrary')
    
    // Add these to ensure consistency - sử dụng version 1.9.22
    implementation 'org.jetbrains.kotlin:kotlin-stdlib:1.9.22'
    implementation 'org.jetbrains.kotlin:kotlin-stdlib-jdk7:1.9.22'
    implementation 'org.jetbrains.kotlin:kotlin-stdlib-jdk8:1.9.22'
    implementation 'androidx.multidex:multidex:2.0.1'
}

android {
    namespace "**NAMESPACE**"
    ndkPath "**NDKPATH**"

    compileSdkVersion **APIVERSION**
    buildToolsVersion '**BUILDTOOLS**'

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_11
        targetCompatibility JavaVersion.VERSION_11
    }

    defaultConfig {
        multiDexEnabled true
        minSdkVersion **MINSDKVERSION**
        targetSdkVersion **TARGETSDKVERSION**
        applicationId '**APPLICATIONID**'
        ndk {
            abiFilters **ABIFILTERS**
        }
        versionCode **VERSIONCODE**
        versionName '**VERSIONNAME**'
    }

    // SỬA LẠI PHẦN NÀY - Sử dụng cú pháp mới cho aaptOptions
    aaptOptions {
        noCompress = ['.unity3d', '.ress', '.resource', '.obb'] + unityStreamingAssets.tokenize(', ')
        ignoreAssetsPattern = "!.svn:!.git:!.ds_store:!*.scc:!CVS:!thumbs.db:!picasa.ini:!*~"
    }**SIGN**

    lintOptions {
        abortOnError false
        checkReleaseBuilds false
    }

    packagingOptions {
        doNotStrip '**/lib/*/lib*.so'
        pickFirst '**/lib/*/lib*.so'
        pickFirst 'META-INF/*'
        exclude 'META-INF/*.version'
        exclude 'META-INF/proguard/*'
        exclude 'META-INF/services/*'
        exclude 'META-INF/LICENSE*'
        exclude 'META-INF/NOTICE*'
    }

    buildTypes {
        debug {
            minifyEnabled **MINIFY_DEBUG**
            proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-unity.txt'**SIGNCONFIG**
            jniDebuggable true
        }
        release {
            minifyEnabled **MINIFY_RELEASE**
            proguardFiles getDefaultProguardFile('proguard-android.txt'), 'proguard-unity.txt'**SIGNCONFIG**
        }
    }**PACKAGING_OPTIONS****PLAY_ASSET_PACKS****SPLITS**
**BUILT_APK_LOCATION**
    bundle {
        language {
            enableSplit = false
        }
        density {
            enableSplit = false
        }
        abi {
            enableSplit = true
        }
    }
}**SPLITS_VERSION_CODE****LAUNCHER_SOURCE_BUILD_SETUP**
